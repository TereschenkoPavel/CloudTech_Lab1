<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Очищаем старые источники и добавляем официальный сервер NuGet -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- ЖЕСТКО ОТКЛЮЧАЕМ ФИЛЬТРАЦИЮ (PackageSourceMapping), из-за которой у вас ошибка -->
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>